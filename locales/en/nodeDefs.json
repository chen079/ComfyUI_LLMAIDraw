  "LLMAIDrawGPTImage": {
    "display_name": "LLMAIDraw · GPT Image",
    "description": "Generate or edit images with OpenAI GPT Image through an API profile or a ChatGPT account.",
    "inputs": {
      "profile": { "name": "Profile", "tooltip": "Profiles come from the gpt_image section of config.json; chatgpt_account signs in with a ChatGPT account." },
      "prompt": { "name": "Prompt" },
      "model": { "name": "Model", "tooltip": "Image model for API profiles. chatgpt_account ignores it: ChatGPT picks the image model. Use the refresh models button to load the models of the selected profile into this list." },
      "custom_model": { "name": "Custom model", "tooltip": "Model name to use instead of model when not empty." },
      "size": { "name": "Size", "tooltip": "Sizes above 2560x1440 are experimental and need a GPT Image 2 or newer model." },
      "quality": { "name": "Quality", "tooltip": "xhigh and max need GPT Image 2.5 or newer." },
      "background": { "name": "Background" },
      "output_format": { "name": "Output format" },
      "output_compression": { "name": "Output compression", "tooltip": "Used only for jpeg and webp." },
      "moderation": { "name": "Moderation" },
      "n": { "name": "Image count" },
      "timeout_sec": { "name": "Timeout (s)" },
      "force_login": { "name": "Force login", "tooltip": "Sign in with ChatGPT again even when chatgpt_account already has a saved login." },
      "image": { "name": "Reference image" },
      "mask": { "name": "Mask", "tooltip": "White marks the area to edit. Applies to the first image." }
    },
    "outputs": { "0": { "name": "Image" } }
  },
